package build

import com.github.lolgab.mill.mima.*
import mill.*
import mill.api.BuildCtx
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalalib.*
import mill.util.Jvm

import java.nio.charset.StandardCharsets
import java.util.zip.ZipFile

import scala.jdk.CollectionConverters.*

object Versions {
  def scala212 = "2.12.21"
  def scala213 = "2.13.18"
  def scalaJs       = "1.22.0"
  def plotlyJs      = "1.54.1"
  def jsoniterScala = "2.41.2"
}

val scalaVersions = Seq(Versions.scala213, Versions.scala212)

object Deps {
  def almondScalaApi = mvn"sh.almond::jupyter-api:0.14.5"
  def dataClass      = mvn"io.github.alexarchambault::data-class:0.2.11"
  def jsoniterCore   = mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-core::${Versions.jsoniterScala}"
  def jsoniterMacros = mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros::${Versions.jsoniterScala}"
  def macroParadise  = mvn"org.scalamacros:::paradise:2.1.1"
  def rhino          = mvn"org.mozilla:rhino:1.9.1"
  def scalajsDom     = mvn"org.scala-js::scalajs-dom::2.8.1"
  def scalatags      = mvn"com.lihaoyi::scalatags::0.13.1"
  def scalaTest      = mvn"org.scalatest::scalatest:3.2.20"
  def ujson          = mvn"com.lihaoyi::ujson:4.4.3"

  def scalaReflect(sv: String) = mvn"org.scala-lang:scala-reflect:$sv"
}

object WebDeps {
  def bootstrap = mvn"org.webjars.bower:bootstrap:3.4.1"
  def jquery    = mvn"org.webjars.bower:jquery:3.7.1"
  def plotlyJs  = mvn"org.webjars.bower:plotly.js:${Versions.plotlyJs}"
  def prism     = mvn"org.webjars.bower:prism:1.16.0"
}

// The version after the "v" if HEAD has a "v*" tag, else the latest "v*" tag version,
// with its third component bumped, and a "-SNAPSHOT" suffix (v0.8.5 -> 0.8.6-SNAPSHOT)
def buildVersion = Task.Input {
  def git(args: String*) =
    os.proc("git", args).call(cwd = BuildCtx.workspaceRoot, check = false).out.lines()
  def versionOf(tag: String) = Some(tag.trim).filter(_.startsWith("v")).map(_.stripPrefix("v"))
  // versionsort.suffix: sort 1.0.0-RC1 before 1.0.0, so that the latter wins if both point at HEAD
  val headVersion = git("-c", "versionsort.suffix=-", "tag", "--points-at", "HEAD", "--list", "v*", "--sort=-v:refname")
    .flatMap(versionOf)
    .headOption
  headVersion.getOrElse {
    val latest = git("describe", "--tags", "--abbrev=0", "--match", "v*")
      .flatMap(versionOf)
      .headOption
      .getOrElse("0.0.0")
    val parts  = latest.split('.').take(3)
    val bumped = parts.init :+ (parts.last.takeWhile(_.isDigit).toInt + 1).toString
    bumped.mkString(".") + "-SNAPSHOT"
  }
}

// commitHash changes with every commit. It's left out of selective execution
// (selectiveInputs = Nil), so that PRs on CI don't re-run everything depending on it.

def commitHash = Task(selectiveInputs = Nil) {
  gitHead()
}

def gitHead = Task.Input {
  os.proc("git", "rev-parse", "HEAD").call(cwd = BuildCtx.workspaceRoot).out.trim()
}

trait ScalaSettings extends CrossScalaModule {
  private def isScala212 = crossScalaVersion.startsWith("2.12.")
  def scalacOptions      = super.scalacOptions() ++
    Seq("-deprecation", "-feature") ++
    // keep targeting Java 11, even when building with a more recent JDK
    Seq("-release", "11") ++
    (if (isScala212) Nil else Seq("-Ymacro-annotations"))
  def scalacPluginMvnDeps = super.scalacPluginMvnDeps() ++
    (if (isScala212) Seq(Deps.macroParadise) else Nil)
}

trait Published extends ScalaSettings, PublishModule {
  def artifactName   = "plotly-" + super.artifactName()
  def publishVersion = buildVersion()
  def pomSettings    = PomSettings(
    description = artifactName(),
    organization = "org.plotly-scala",
    url = "https://github.com/alexarchambault/plotly-scala",
    licenses = Seq(
      License(
        id = "LGPL-3.0",
        name = "LGPL 3.0",
        url = "http://opensource.org/licenses/LGPL-3.0",
        distribution = "repo"
      )
    ),
    versionControl = VersionControl.github("alexarchambault", "plotly-scala"),
    developers = Seq(
      Developer("alexarchambault", "Alexandre Archambault", "https://github.com/alexarchambault")
    )
  )
  // publish (almost) empty javadoc JARs, with only a manifest in them
  def docJar = Task {
    PathRef(Jvm.createJar(Task.dest / "out.jar", Seq.empty[os.Path]))
  }
}

trait PublishedJvm extends Published, Mima {
  def mimaPreviousVersions = Task(Seq.empty[String])
  // unlike the default, doesn't fail when mimaPreviousVersions is empty
  def mimaPreviousArtifacts = Task {
    mimaPreviousVersions().map(v => mvn"${pomSettings().organization}:${artifactId()}:$v")
  }
}

trait PublishedJs extends Published, ScalaJSModule {
  def scalaJSVersion = Versions.scalaJs
}

// sbt-crossproject-like layout: foo/shared/src/main/scala, foo/jvm/src/main/scala, …
trait Platform extends CrossSbtPlatformModule {
  def sourcesRootFolders = Seq(os.sub / "shared", os.sub / platformCrossSuffix)
}

object core extends Module {
  object jvm extends Cross[Jvm](scalaVersions)
  trait Jvm  extends PublishedJvm, Platform {
    // scala-reflect is needed to compile the Enumerate macro
    def compileMvnDeps = Seq(Deps.dataClass, Deps.scalaReflect(scalaVersion()))
  }

  object js extends Cross[Js](scalaVersions)
  trait Js  extends PublishedJs, Platform {
    def compileMvnDeps = Seq(Deps.dataClass, Deps.scalaReflect(scalaVersion()))
  }
}

object render extends Module {
  object jvm extends Cross[Jvm](scalaVersions)
  trait Jvm  extends PublishedJvm, Platform {
    def moduleDeps     = Seq(core.jvm())
    def mvnDeps        = Seq(Deps.jsoniterCore, WebDeps.plotlyJs)
    def compileMvnDeps = Seq(Deps.jsoniterMacros)

    def propertiesResource = Task {
      val props = Seq(
        "plotly-js-version" -> Versions.plotlyJs,
        "version"           -> publishVersion(),
        "commit-hash"       -> commitHash()
      )
      for ((k, v) <- props)
        assert(!v.contains("\n"), s"Invalid \\n character in property $k")
      os.write(
        Task.dest / "plotly/plotly-scala.properties",
        props.map { case (k, v) => s"$k=$v" }.mkString("\n"),
        createFolders = true
      )
      PathRef(Task.dest)
    }
    def resources = Task(super.resources() ++ Seq(propertiesResource()))

    object test extends CrossSbtPlatformTests, TestModule.ScalaTest {
      def mvnDeps = Seq(Deps.scalaTest)
    }
  }

  object js extends Cross[Js](scalaVersions)
  trait Js  extends PublishedJs, Platform {
    def moduleDeps     = Seq(core.js())
    def mvnDeps        = Seq(Deps.jsoniterCore, Deps.scalajsDom)
    def compileMvnDeps = Seq(Deps.jsoniterMacros)
  }
}

object almond extends Cross[Almond](scalaVersions)
trait Almond  extends PublishedJvm, CrossSbtModule {
  def moduleDeps     = Seq(core.jvm(), render.jvm())
  def compileMvnDeps = Seq(Deps.almondScalaApi)
  // for com.github.jupyter:jvm-repr, a dependency of jupyter-api
  def repositories = super.repositories() ++ Seq("https://jitpack.io")
}

object tests extends Cross[Tests](scalaVersions)
trait Tests  extends ScalaSettings, CrossSbtModule {
  def moduleDeps = Seq(core.jvm(), render.jvm())

  object test extends CrossSbtTests, TestModule.ScalaTest {
    def mvnDeps = Seq(Deps.scalaTest, Deps.rhino, Deps.ujson)
    // the tests read the plotly-documentation submodule, relative to the workspace root
    def testSandboxWorkingDir = false
    def forkWorkingDir        = BuildCtx.workspaceRoot
    // selective execution only looks at the submodule commit, so that selective.prepare
    // doesn't fetch the submodule
    def forkArgs = Task(selectiveInputs = Seq(testDataCommit, super.forkArgs)) {
      // ensure the submodule is there before running the tests
      fetchTestData()
      super.forkArgs()
    }
  }
}

// Submodule commit recorded in the git index, so that selective execution
// re-runs the tests when it changes
def testDataCommit = Task.Input {
  os.proc("git", "rev-parse", ":plotly-documentation").call(cwd = BuildCtx.workspaceRoot).out.trim()
}

def fetchTestData = Task.Input {
  val baseDir       = BuildCtx.workspaceRoot
  val testsPostsDir = baseDir / "plotly-documentation" / "_posts"
  if (!os.exists(testsPostsDir)) {
    Task.log.info("Fetching submodule plotly-documentation (this may take some time)")
    BuildCtx.withFilesystemCheckerDisabled {
      os.proc("git", "submodule", "update", "--init", "--recursive", "--", "plotly-documentation")
        .call(cwd = baseDir, stdout = os.Inherit)
    }
    Task.log.info("Successfully fetched submodule plotly-documentation")
  }
  ()
}

object demo extends ScalaJSModule, SbtModule {
  def scalaVersion   = Versions.scala213
  def scalaJSVersion = Versions.scalaJs
  def scalacOptions  = Seq("-deprecation", "-feature", "-Ymacro-annotations")
  def moduleDeps     = Seq(render.js(Versions.scala213))
  def mvnDeps        = Seq(Deps.scalatags)

  def demoSources = Task.Sources("src/main/scala/plotly/demo")

  // Generates Properties.scala, and *Source.scala files containing the
  // source code of the demos (between "demo source start" and "demo source end")
  def generatedSources = Task {
    val dest = Task.dest
    os.write(
      dest / "plotly/demo/Properties.scala",
      s"""package plotly.demo
         |
         |object Properties {
         |
         |  val version = "${buildVersion()}"
         |  val commitHash = "${commitHash()}"
         |
         |}
         |""".stripMargin,
      createFolders = true
    )

    val tq = "\"\"\""
    for {
      root <- demoSources().map(_.path)
      file <- os.walk(root)
      if os.isFile(file) && file.ext == "scala"
    } {
      val demoLines = os.read
        .lines(file)
        .dropWhile(!_.contains("demo source start"))
        .drop(1)
        .takeWhile(!_.contains("demo source end"))
        .map(l => l.replace(tq, tq + " + \"\\\"\\\"\\\"\" + " + tq))

      if (demoLines.nonEmpty) {
        val pkg  = (Seq("plotly", "demo") ++ (file / os.up).relativeTo(root).segments).mkString(".")
        val name = file.baseName + "Source"
        os.write(
          dest / "plotly" / "demo" / (file / os.up).relativeTo(root) / s"$name.scala",
          s"""package $pkg
             |
             |object $name {
             |
             |  val source = $tq${demoLines.mkString("\n")}$tq
             |
             |}
             |""".stripMargin,
          createFolders = true
        )
      }
    }

    super.generatedSources() ++ Seq(PathRef(dest))
  }

  def webJars = Task {
    defaultResolver().classpath(
      Seq(WebDeps.plotlyJs, WebDeps.jquery, WebDeps.bootstrap, WebDeps.prism).map(_.exclude("*" -> "*"))
    )
  }
  // JS dependencies of the demo, concatenated in this order
  def jsDependencies = Seq(
    "plotly.min.js",
    "jquery.min.js",
    "bootstrap.min.js",
    "prism.js",
    "prism-clike.js",
    "prism-java.js",
    "prism-scala.js"
  )
  def jsDeps = Task {
    val dest     = Task.dest / "plotly-demo-jsdeps.js"
    val contents = jsDependencies.map { name =>
      val matches = webJars().flatMap { jar =>
        val zip = new ZipFile(jar.path.toIO)
        try {
          zip
            .entries()
            .asScala
            .filter(e => !e.isDirectory && e.getName.endsWith("/" + name))
            .map(e => new String(zip.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8))
            .toVector
        } finally zip.close()
      }
      matches match {
        case Seq(content) => content
        case other        => Task.fail(s"Expected one $name file in web JARs, found ${other.length}")
      }
    }
    os.write(dest, contents.map(_ + "\n").mkString)
    PathRef(dest)
  }

  private def site(report: Task[mill.scalajslib.api.Report]) = Task.Anon {
    val dest    = Task.dest
    val linkDir = report().dest.path
    for (f <- Seq("main.js", "main.js.map") if os.exists(linkDir / f))
      os.copy(linkDir / f, dest / f)
    os.copy(jsDeps().path, dest / "plotly-demo-jsdeps.js")
    for (res <- resources().map(_.path) if os.exists(res))
      os.copy(res, dest, mergeFolders = true)
    PathRef(dest)
  }

  /** The demo page, built with the fast (non-optimized) Scala.js linker */
  def fastSite = Task(site(fastLinkJS)())

  /** The demo page, built with the full Scala.js optimizer */
  def fullSite = Task(site(fullLinkJS)())

  /** Copies the full demo site to dir (relative to the workspace root), for publishing to GitHub pages */
  def makeGhPages(@mainargs.arg(positional = true) dir: String = "gh-pages") = Task.Command {
    val dest = os.Path(dir, BuildCtx.workspaceRoot)
    if (os.exists(dest))
      Task.fail(s"Error: $dest already exists.")
    os.copy(fullSite().path, dest, createFolders = true)
    Task.log.info(s"Wrote demo site to $dest")
  }
}
