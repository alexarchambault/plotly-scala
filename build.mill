import scala.jdk.CollectionConverters.*
import scala.util.Properties

object Versions {
  def scala212 = "2.12.21"
  def scala213 = "2.13.18"
  // the Scala 3 LTS, so that the library can be used from any later Scala 3 version
  def scala3  = "3.9.0"
  def scalaJs = "1.23.0"
  // a snapshot, for the nullOptionBuilderMethodName and nullOptionCopyMethodName @data arguments
  def dataClass     = "0.3.2-SNAPSHOT"
  def plotlyJs      = "4.1.0"
  def jsoniterScala = "2.43.0"

  // Used by the dev.* commands
  // almond version of the dev.jupyterCmd kernels: a snapshot, for the new notebook coursier logger
  // (--use-notebook-coursier-logger), that doesn't show failed downloads (like those of the
  // sources JARs that don't exist), coming after 0.15.0
  def almond   = "0.15.1-SNAPSHOT"
  def coursier = "2.1.26" // cs launcher installing these kernels
  def uv       = "0.12.18"
  def devJvm   = "21"     // JVM these kernels run on
}

val scalaVersions = Seq(Versions.scala213, Versions.scala212, Versions.scala3)

object Deps {
  def almondScalaApi = mvn"sh.almond::jupyter-api:0.14.5"
  def dataClass      = mvn"io.github.alexarchambault::data-class:${Versions.dataClass}"
  def jsoniterCore   = mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-core::${Versions.jsoniterScala}"
  def jsoniterMacros = mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros::${Versions.jsoniterScala}"
  def macroParadise  = mvn"org.scalamacros:::paradise:2.1.1"
  def munit          = mvn"org.scalameta::munit:1.3.6"
  def rhino          = mvn"org.mozilla:rhino:1.9.2"
  def scalajsDom     = mvn"org.scala-js::scalajs-dom::2.8.1"
  def scalatags      = mvn"com.lihaoyi::scalatags::0.13.1"
  def ujson          = mvn"com.lihaoyi::ujson:4.4.3"

  def scalaReflect(sv: String) = mvn"org.scala-lang:scala-reflect:$sv"

  // the data-class compiler plugin, on Scala 3 (compiler plugins are built against exact Scala versions)
  def dataClassPlugin = mvn"io.github.alexarchambault:::data-class-plugin:${Versions.dataClass}"
}

object WebDeps {
  def plotlyJs = mvn"org.webjars.npm:plotly.js-dist-min:${Versions.plotlyJs}"
  def prism    = mvn"org.webjars.bower:prism:1.16.0"
}

// The version after the "v" if HEAD has a "v*" tag, else the latest "v*" tag version,
// with its third component bumped, and a "-SNAPSHOT" suffix (v0.8.5 -> 0.8.6-SNAPSHOT)
def buildVersion = Task.Input {
  def git(args: String*) =
    os.proc("git", args).call(cwd = BuildCtx.workspaceRoot, check = false).out.lines()
  def versionOf(tag: String) = Some(tag.trim).filter(_.startsWith("v")).map(_.stripPrefix("v"))
  // versionsort.suffix: sort 1.0.0-RC1 before 1.0.0, so that the latter wins if both point at HEAD
  val headVersion = git("-c", "versionsort.suffix=-", "tag", "--points-at", "HEAD", "--list", "v*", "--sort=-v:refname")
    .flatMap(versionOf)
    .headOption
  headVersion.getOrElse {
    val latest = git("describe", "--tags", "--abbrev=0", "--match", "v*")
      .flatMap(versionOf)
      .headOption
      .getOrElse("0.0.0")
    val parts  = latest.split('.').take(3)
    val bumped = parts.init :+ (parts.last.takeWhile(_.isDigit).toInt + 1).toString
    bumped.mkString(".") + "-SNAPSHOT"
  }
}

// commitHash changes with every commit. It's left out of selective execution
// (selectiveInputs = Nil), so that PRs on CI don't re-run everything depending on it.

def commitHash = Task(selectiveInputs = Nil) {
  gitHead()
}

def gitHead = Task.Input {
  os.proc("git", "rev-parse", "HEAD").call(cwd = BuildCtx.workspaceRoot).out.trim()
}

// CrossScalaVersionRanges: scala-2.13+ source directories, for both Scala 2.13 and Scala 3
trait ScalaSettings extends CrossScalaModule, CrossScalaVersionRanges {
  protected def isScala212 = crossScalaVersion.startsWith("2.12.")
  protected def isScala3   = crossScalaVersion.startsWith("3.")
  def scalacOptions        = super.scalacOptions() ++
    Seq("-deprecation", "-feature") ++
    // keep targeting Java 11, even when building with a more recent JDK
    Seq("-release", "11") ++
    // On Scala 2, data-class expands the @data / @since annotations itself (macro annotations).
    // On Scala 3, the data-class compiler plugin generates the binary-compatible overloads of
    // @since parameters, and makes compilation fail if it's not enabled.
    (if (isScala212) Nil else if (isScala3) Seq("-Xplugin-require:data-class") else Seq("-Ymacro-annotations"))
  def scalacPluginMvnDeps = super.scalacPluginMvnDeps() ++
    (if (isScala212) Seq(Deps.macroParadise) else if (isScala3) Seq(Deps.dataClassPlugin) else Nil)
  // for the data-class snapshots
  def repositories = super.repositories() ++ Seq("central:maven-snapshots")
}

trait Published extends ScalaSettings, PublishModule {
  def artifactName   = "plotly-" + super.artifactName()
  def publishVersion = buildVersion()
  def pomSettings    = PomSettings(
    description = artifactName(),
    organization = "org.plotly-scala",
    url = "https://github.com/alexarchambault/plotly-scala",
    licenses = Seq(
      License(
        id = "LGPL-3.0",
        name = "LGPL 3.0",
        url = "http://opensource.org/licenses/LGPL-3.0",
        distribution = "repo"
      )
    ),
    versionControl = VersionControl.github("alexarchambault", "plotly-scala"),
    developers = Seq(
      Developer("alexarchambault", "Alexandre Archambault", "https://github.com/alexarchambault")
    )
  )
  // publish (almost) empty javadoc JARs, with only a manifest in them
  def docJar = Task {
    PathRef(Jvm.createJar(Task.dest / "out.jar", Seq.empty[os.Path]))
  }
}

trait PublishedJvm extends Published, Mima {
  def mimaPreviousVersions = Task(Seq.empty[String])
  // unlike the default, doesn't fail when mimaPreviousVersions is empty
  def mimaPreviousArtifacts = Task {
    mimaPreviousVersions().map(v => mvn"${pomSettings().organization}:${artifactId()}:$v")
  }
}

trait PublishedJs extends Published, ScalaJSModule {
  def scalaJSVersion = Versions.scalaJs
}

// sbt-crossproject-like layout: foo/shared/src/main/scala, foo/jvm/src/main/scala, …
trait Platform extends CrossSbtPlatformModule {
  def sourcesRootFolders = Seq(os.sub / "shared", os.sub / platformCrossSuffix)
}

object core extends Module {
  trait Core extends ScalaSettings {
    // scala-reflect is needed to compile the Enumerate macro
    def compileMvnDeps =
      Seq(Deps.dataClass) ++ (if (isScala3) Nil else Seq(Deps.scalaReflect(scalaVersion())))
  }

  object jvm extends Cross[Jvm](scalaVersions)
  trait Jvm  extends PublishedJvm, Platform, Core

  object js extends Cross[Js](scalaVersions)
  trait Js  extends PublishedJs, Platform, Core
}

object render extends Module {
  object jvm extends Cross[Jvm](scalaVersions)
  trait Jvm  extends PublishedJvm, Platform {
    def moduleDeps     = Seq(core.jvm())
    def mvnDeps        = Seq(Deps.jsoniterCore, WebDeps.plotlyJs)
    def compileMvnDeps = Seq(Deps.jsoniterMacros)

    def propertiesResource = Task {
      val props = Seq(
        "plotly-js-version" -> Versions.plotlyJs,
        "version"           -> publishVersion(),
        "commit-hash"       -> commitHash()
      )
      for ((k, v) <- props)
        assert(!v.contains("\n"), s"Invalid \\n character in property $k")
      os.write(
        Task.dest / "plotly/plotly-scala.properties",
        props.map { case (k, v) => s"$k=$v" }.mkString("\n"),
        createFolders = true
      )
      PathRef(Task.dest)
    }
    def resources = Task(super.resources() ++ Seq(propertiesResource()))

    object test extends CrossSbtPlatformTests, TestModule.Munit {
      def mvnDeps = Seq(Deps.munit)
    }
  }

  object js extends Cross[Js](scalaVersions)
  trait Js  extends PublishedJs, Platform {
    def moduleDeps     = Seq(core.js())
    def mvnDeps        = Seq(Deps.jsoniterCore, Deps.scalajsDom)
    def compileMvnDeps = Seq(Deps.jsoniterMacros)
  }
}

object almond extends Cross[Almond](scalaVersions)
trait Almond  extends PublishedJvm, CrossSbtModule {
  def moduleDeps     = Seq(core.jvm(), render.jvm())
  def compileMvnDeps = Seq(Deps.almondScalaApi)
  // for com.github.jupyter:jvm-repr, a dependency of jupyter-api
  def repositories = super.repositories() ++ Seq("https://jitpack.io")
}

object tests extends Cross[Tests](scalaVersions)
trait Tests  extends ScalaSettings, CrossSbtModule {
  def moduleDeps = Seq(core.jvm(), render.jvm())

  object test extends CrossSbtTests, TestModule.Munit {
    def mvnDeps = Seq(Deps.munit, Deps.rhino, Deps.ujson)
    // the tests read the plotly-documentation submodule, relative to the workspace root
    def testSandboxWorkingDir = false
    def forkWorkingDir        = BuildCtx.workspaceRoot
    // selective execution only looks at the submodule commit, so that selective.prepare
    // doesn't fetch the submodule
    def forkArgs = Task(selectiveInputs = Seq(testDataCommit, super.forkArgs)) {
      // ensure the submodule is there before running the tests
      fetchTestData()
      super.forkArgs()
    }
  }
}

// Submodule commit recorded in the git index, so that selective execution
// re-runs the tests when it changes
def testDataCommit = Task.Input {
  os.proc("git", "rev-parse", ":plotly-documentation").call(cwd = BuildCtx.workspaceRoot).out.trim()
}

def fetchTestData = Task.Input {
  val baseDir       = BuildCtx.workspaceRoot
  val testsPostsDir = baseDir / "plotly-documentation" / "_posts"
  if (!os.exists(testsPostsDir)) {
    Task.log.info("Fetching submodule plotly-documentation (this may take some time)")
    BuildCtx.withFilesystemCheckerDisabled {
      os.proc("git", "submodule", "update", "--init", "--recursive", "--", "plotly-documentation")
        .call(cwd = baseDir, stdout = os.Inherit)
    }
    Task.log.info("Successfully fetched submodule plotly-documentation")
  }
  ()
}

object demo extends ScalaJSModule, SbtModule {
  def scalaVersion   = Versions.scala213
  def scalaJSVersion = Versions.scalaJs
  def scalacOptions  = Seq("-deprecation", "-feature", "-Ymacro-annotations")
  def moduleDeps     = Seq(render.js(Versions.scala213))
  def mvnDeps        = Seq(Deps.scalatags)

  def demoSources = Task.Sources("src/main/scala/plotly/demo")

  // Generates Properties.scala, and *Source.scala files containing the
  // source code of the demos (between "demo source start" and "demo source end")
  def generatedSources = Task {
    val dest = Task.dest
    os.write(
      dest / "plotly/demo/Properties.scala",
      s"""package plotly.demo
         |
         |object Properties {
         |
         |  val version = "${buildVersion()}"
         |  val commitHash = "${commitHash()}"
         |
         |}
         |""".stripMargin,
      createFolders = true
    )

    val tq = "\"\"\""
    for {
      root <- demoSources().map(_.path)
      file <- os.walk(root)
      if os.isFile(file) && file.ext == "scala"
    } {
      val demoLines = os.read
        .lines(file)
        .dropWhile(!_.contains("demo source start"))
        .drop(1)
        .takeWhile(!_.contains("demo source end"))
        .map(l => l.replace(tq, tq + " + \"\\\"\\\"\\\"\" + " + tq))

      if (demoLines.nonEmpty) {
        val pkg  = (Seq("plotly", "demo") ++ (file / os.up).relativeTo(root).segments).mkString(".")
        val name = file.baseName + "Source"
        os.write(
          dest / "plotly" / "demo" / (file / os.up).relativeTo(root) / s"$name.scala",
          s"""package $pkg
             |
             |object $name {
             |
             |  val source = $tq${demoLines.mkString("\n")}$tq
             |
             |}
             |""".stripMargin,
          createFolders = true
        )
      }
    }

    super.generatedSources() ++ Seq(PathRef(dest))
  }

  def webJars = Task {
    defaultResolver().classpath(
      Seq(WebDeps.plotlyJs, WebDeps.prism).map(_.exclude("*" -> "*"))
    )
  }
  // JS dependencies of the demo, concatenated in this order
  def jsDependencies = Seq(
    "plotly.min.js",
    "prism.js",
    "prism-clike.js",
    "prism-java.js",
    "prism-scala.js"
  )
  def jsDeps = Task {
    val dest     = Task.dest / "plotly-demo-jsdeps.js"
    val contents = jsDependencies.map { name =>
      val matches = webJars().flatMap { jar =>
        val zip = new ZipFile(jar.path.toIO)
        try {
          zip
            .entries()
            .asScala
            .filter(e => !e.isDirectory && e.getName.endsWith("/" + name))
            .map(e => new String(zip.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8))
            .toVector
        } finally zip.close()
      }
      matches match {
        case Seq(content) => content
        case other        => Task.fail(s"Expected one $name file in web JARs, found ${other.length}")
      }
    }
    os.write(dest, contents.map(_ + "\n").mkString)
    PathRef(dest)
  }

  private def site(report: Task[mill.scalajslib.api.Report]) = Task.Anon {
    val dest    = Task.dest
    val linkDir = report().dest.path
    for (f <- Seq("main.js", "main.js.map") if os.exists(linkDir / f))
      os.copy(linkDir / f, dest / f)
    os.copy(jsDeps().path, dest / "plotly-demo-jsdeps.js")
    for (res <- resources().map(_.path) if os.exists(res))
      os.copy(res, dest, mergeFolders = true)
    PathRef(dest)
  }

  /** The demo page, built with the fast (non-optimized) Scala.js linker */
  def fastSite = Task(site(fastLinkJS)())

  /** The demo page, built with the full Scala.js optimizer */
  def fullSite = Task(site(fullLinkJS)())

  /** Copies the full demo site to dir (relative to the workspace root), for publishing to GitHub pages */
  def makeGhPages(@mainargs.arg(positional = true) dir: String = "gh-pages") = Task.Command {
    val dest = os.Path(dir, BuildCtx.workspaceRoot)
    if (os.exists(dest))
      Task.fail(s"Error: $dest already exists.")
    os.copy(fullSite().path, dest, createFolders = true)
    Task.log.info(s"Wrote demo site to $dest")
  }
}

/** Commands to try the modules built from sources: in JupyterLab, with almond, and on the demo page.
  *
  * The `*Cmd` commands print a shell command line, to be run with `eval`, like
  * {{{
  * eval "$(./mill show dev.jupyterCmd | jq -r .)"
  * }}}
  * (see `services.json`).
  */
object dev extends Module {

  /** The modules we publish, for all the Scala versions */
  def publishedModules: Seq[PublishModule] =
    scalaVersions.flatMap { sv =>
      Seq(core.jvm(sv), core.js(sv), render.jvm(sv), render.js(sv), almond(sv))
    }

  /** A Maven repository with all the modules of [[publishedModules]] */
  def localRepo: T[PathRef] = {
    val repos = Task.sequence(publishedModules.map(_.publishLocalTestRepo))
    Task {
      for {
        repo <- repos()
        elem <- os.list(repo.path)
      }
        os.copy.into(elem, Task.dest, mergeFolders = true)
      PathRef(Task.dest)
    }
  }

  /** Installs almond kernels, one per Scala version of [[scalaVersions]], and prints the command
    * running JupyterLab with them, with `COURSIER_REPOSITORIES` pointing at [[localRepo]].
    * JupyterLab is run from `notebooks`, where the notebooks of `demo/notebooks` are linked.
    *
    * Accepts `--base-address=…`, the external address JupyterLab is accessed from, like
    * `https://host/some/path/`, when it's run behind a proxy. Other arguments are passed to
    * JupyterLab.
    */
  def jupyterCmd(args: String*) = Task.Command(persistent = true) {
    val dependency = s"${almond(Versions.scala213).pomSettings().organization}::" +
      s"${almond(Versions.scala213).artifactName()}:${almond(Versions.scala213).publishVersion()}"
    val cmd = DevTools.jupyterLabCommand(
      BuildCtx.workspaceRoot,
      localRepo().path,
      Task.dest / "jupyter",
      args
    )
    System.err.println(s"Load plotly-scala from notebooks with\n  //> using dep $dependency")
    cmd.shellCommand
  }

  /** Builds the demo page, and prints the command serving it.
    *
    * Accepts `--host=…` (the address to bind to, `localhost` by default) and `--port=…` (8000 by
    * default).
    */
  def demoCmd(args: String*) = Task.Command {
    val (hostOpt, args0) = DevTools.extractOption(args, "--host")
    val (portOpt, args1) = DevTools.extractOption(args0, "--port")
    if (args1.nonEmpty)
      Task.fail(s"Unrecognized arguments: ${args1.mkString(" ")} (expected --host, --port)")
    DevTools
      .Command(
        BuildCtx.workspaceRoot,
        Map.empty,
        Seq(
          DevTools.uv.toString,
          "run",
          "--no-project",
          "python",
          "-m",
          "http.server",
          portOpt.getOrElse("8000"),
          "--bind",
          hostOpt.getOrElse("localhost"),
          "--directory",
          demo.fastSite().path.toString
        )
      )
      .shellCommand
  }

  /** The lock file of the Jupyter environment of [[jupyterCmd]] */
  def jupyterLock = Task.Source(BuildCtx.workspaceRoot / "jupyter" / "uv.lock")

  /** Checks that the plotly.js version bundled by the JupyterLab renderer of plotly outputs, that
    * comes with the `plotly` Python package of the Jupyter environment of [[jupyterCmd]], is
    * compatible with the one of the library, [[Versions.plotlyJs]].
    *
    * In JupyterLab, the plotly outputs of plotly-scala (`application/vnd.plotly.v1+json`) are
    * rendered by that renderer, with its own plotly.js, rather than by the plotly.js of the library.
    * The renderer should have the same major version (major versions drop attributes, like the
    * string titles plotly.js 3 ignores), and a minor version at least as recent as the library's,
    * so that it supports the attributes the library may emit.
    */
  def checkPlotlyJs = Task {
    val (pythonPlotly, rendererPlotlyJs) = DevTools.rendererPlotlyJsVersion(jupyterLock().path)
    val library                          = Versions.plotlyJs
    DevTools.plotlyJsIncompatibility(library, rendererPlotlyJs) match {
      case Some(reason) =>
        Task.fail(
          s"The plotly.js version of the JupyterLab renderer of plotly $pythonPlotly in " +
            s"jupyter/uv.lock, $rendererPlotlyJs, isn't compatible with the one of plotly-scala, " +
            s"$library: $reason"
        )
      case None =>
        val message = s"plotly.js $library (plotly-scala) and $rendererPlotlyJs " +
          s"(JupyterLab renderer of plotly $pythonPlotly in jupyter/uv.lock) are compatible"
        Task.log.info(message)
        message
    }
  }
}

/** Helpers of the [[dev]] commands */
object DevTools {
  import coursier.cache.{ArchiveCache, FileCache}
  import coursier.jvm.{JavaHome, JvmCache}
  import coursier.util.Artifact

  /** A command to run: `command`, from the `cwd` directory, with the `env` variables added to the
    * environment
    */
  final case class Command(cwd: os.Path, env: Map[String, String], command: Seq[String]) {

    /** This command as a single shell command line, to pass to `eval` in a POSIX shell: a `cd` to
      * `cwd`, `VAR=value` assignments for `env`, then the command itself
      */
    def shellCommand: String =
      (Seq(s"cd ${shellQuote(cwd.toString)} &&") ++
        env.toSeq.sorted.map { case (k, v) => s"$k=${shellQuote(v)}" } ++
        command.map(shellQuote)).mkString(" ")
  }

  private def shellQuote(s: String): String = {
    def isSafe(c: Char) =
      (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
        "_@%+=:,./-".contains(c)
    if (s.nonEmpty && s.forall(isSafe)) s
    else "'" + s.replace("'", "'\\''") + "'"
  }

  /** Extracts an option like `--name=value` or `--name value` from `args`, and returns its value,
    * if any, along with the remaining arguments
    */
  def extractOption(args: Seq[String], name: String): (Option[String], Seq[String]) =
    args.indexWhere(a => a == name || a.startsWith(name + "=")) match {
      case -1  => (None, args)
      case idx =>
        val arg = args(idx)
        if (arg == name)
          if (idx + 1 < args.length) (Some(args(idx + 1)), args.patch(idx, Nil, 2))
          else sys.error(s"Missing value for $name")
        else
          (Some(arg.stripPrefix(name + "=")), args.patch(idx, Nil, 1))
    }

  private def arch =
    sys.props.getOrElse("os.arch", "").toLowerCase(java.util.Locale.ROOT) match {
      case "amd64" | "x86_64"  => "x86_64"
      case "aarch64" | "arm64" => "aarch64"
      case other               => sys.error(s"Unsupported CPU architecture: $other")
    }

  /** Downloads `url` to the coursier cache, and extracts it if it's an archive */
  private def download(url: String): os.Path = {
    val archiveCache = ArchiveCache()
    archiveCache.get(Artifact(url)).unsafeRun()(using archiveCache.cache.ec) match {
      case Left(err) => throw new Exception(s"Error downloading $url", err)
      case Right(f)  => os.Path(f.getAbsoluteFile)
    }
  }

  /** The version of the `plotly` Python package locked in `uvLock` (a `uv.lock` file), along with
    * the version of the plotly.js bundled by its JupyterLab renderer, read from its wheel
    */
  def rendererPlotlyJsVersion(uvLock: os.Path): (String, String) = {
    val packages = os.read(uvLock).split("\n\\[\\[package\\]\\]\n").toSeq
    val block    = packages.find(_.linesIterator.contains("name = \"plotly\"")).getOrElse {
      sys.error(s"No plotly package in $uvLock")
    }
    val version = "(?m)^version = \"([^\"]+)\"".r
      .findFirstMatchIn(block)
      .map(_.group(1))
      .getOrElse(sys.error(s"No version for plotly in $uvLock"))
    val (url, sha256) =
      "\\{ url = \"([^\"]+\\.whl)\", hash = \"sha256:([0-9a-f]+)\"".r
        .findFirstMatchIn(block)
        .map(m => (m.group(1), m.group(2)))
        .getOrElse(sys.error(s"No wheel for plotly in $uvLock"))
    val wheel        = downloadFile(url)
    val actualSha256 = {
      val digest = java.security.MessageDigest.getInstance("SHA-256").digest(os.read.bytes(wheel))
      digest.map(b => f"$b%02x").mkString
    }
    if (actualSha256 != sha256)
      sys.error(s"Wrong SHA-256 for $url ($wheel): expected $sha256, got $actualSha256")
    val extensionDir                              = "share/jupyter/labextensions/jupyterlab-plotly/"
    val zf                                        = new ZipFile(wheel.toIO)
    def readEntry(suffix: String): Option[String] =
      zf.entries().asScala.find(_.getName.endsWith(extensionDir + suffix)).map { entry =>
        val is = zf.getInputStream(entry)
        try new String(is.readAllBytes(), StandardCharsets.UTF_8)
        finally is.close()
      }
    val plotlyJs =
      try {
        // lists the packages bundled by the renderer, plotly.js among them, up to plotly 6
        val fromLicenses = readEntry("static/third-party-licenses.json").flatMap { licenses =>
          ujson
            .read(licenses)("packages")
            .arr
            .find(_("name").str == "plotly.js")
            .map(_("versionInfo").str)
        }
        // from plotly 7, plotly.js isn't listed there, but its package.json depends on an exact
        // plotly.js version, the one it bundles
        def fromPackageJson = readEntry("package.json").flatMap { packageJson =>
          ujson
            .read(packageJson)
            .obj
            .get("dependencies")
            .flatMap(_.obj.get("plotly.js"))
            .map(_.str)
            .filter(_.matches("[0-9]+\\.[0-9]+\\.[0-9]+"))
        }
        fromLicenses.orElse(fromPackageJson).getOrElse {
          sys.error(
            s"Neither ${extensionDir}static/third-party-licenses.json nor ${extensionDir}package.json " +
              s"in $url give the version of plotly.js"
          )
        }
      } finally zf.close()
    (version, plotlyJs)
  }

  /** Why the plotly.js version of a renderer, `renderer`, isn't compatible with the one of the
    * library, `library`, if it's not: it needs the same major version, and a minor version at least
    * as recent
    */
  def plotlyJsIncompatibility(library: String, renderer: String): Option[String] = {
    def majorMinor(v: String) = v.split('.').take(2).map(_.takeWhile(_.isDigit)) match {
      case Array(major, minor) if major.nonEmpty && minor.nonEmpty => (major.toInt, minor.toInt)
      case _                                                       => sys.error(s"Malformed plotly.js version: $v")
    }
    val (libMajor, libMinor) = majorMinor(library)
    val (renMajor, renMinor) = majorMinor(renderer)
    if (libMajor != renMajor) Some("major versions differ")
    else if (renMinor < libMinor)
      Some(s"the renderer is older than $libMajor.$libMinor, it may not support all the attributes")
    else None
  }

  /** Downloads `url` to the coursier cache, as is */
  private def downloadFile(url: String): os.Path = {
    val cache = FileCache()
    cache.file(Artifact(url)).run.unsafeRun()(using cache.ec) match {
      case Left(err) => throw new Exception(s"Error downloading $url", err)
      case Right(f)  => os.Path(f.getAbsoluteFile)
    }
  }

  /** The Maven Central snapshot repository, where the snapshots of [[Versions.almond]] are */
  private def mavenSnapshots = "https://central.sonatype.com/repository/maven-snapshots"

  /** A `uv` launcher, downloaded if needed */
  def uv: os.Path = {
    val target =
      if (Properties.isWin) s"$arch-pc-windows-msvc"
      else if (Properties.isMac) s"$arch-apple-darwin"
      else s"$arch-unknown-linux-gnu"
    val ext  = if (Properties.isWin) "zip" else "tar.gz"
    val url  = s"https://github.com/astral-sh/uv/releases/download/${Versions.uv}/uv-$target.$ext"
    val dir  = download(url)
    val name = if (Properties.isWin) "uv.exe" else "uv"
    // The tar.gz archives have a top-level "uv-<target>" directory, the zip ones don't
    Seq(dir / name, dir / s"uv-$target" / name).find(os.exists(_)).getOrElse {
      sys.error(s"$name not found in $url (extracted under $dir)")
    }
  }

  /** A `cs` launcher, downloaded if needed */
  def cs: os.Path = {
    val (target, ext) =
      if (Properties.isWin) (s"$arch-pc-win32", "zip")
      else if (Properties.isMac) (s"$arch-apple-darwin", "gz")
      else (s"$arch-pc-linux", "gz")
    val url =
      s"https://github.com/coursier/coursier/releases/download/v${Versions.coursier}/cs-$target.$ext"
    val f = download(url)
    if (Properties.isWin)
      os.list(f).find(_.last.endsWith(".exe")).getOrElse(sys.error(s"No .exe found under $f"))
    else {
      f.toIO.setExecutable(true)
      f
    }
  }

  /** Java home for the passed JVM id (like "21"), downloaded by coursier if needed */
  def javaHome(id: String): os.Path = {
    val jvmCache = JvmCache().withDefaultIndex
    val home     = JavaHome()
      .withCache(jvmCache)
      .get(id)
      .unsafeRun()(using jvmCache.archiveCache.cache.ec)
    os.Path(home.getAbsoluteFile)
  }

  /** Environment variables making the JVM at `javaHome` the default one for sub-processes */
  private def javaEnvironment(javaHome: os.Path): Map[String, String] = {
    val pathKey     = sys.env.keys.find(_.equalsIgnoreCase("PATH")).getOrElse("PATH")
    val currentPath = sys.env.get(pathKey).filter(_.nonEmpty).toSeq
    Map(
      "JAVA_HOME" -> javaHome.toString,
      pathKey     -> ((javaHome / "bin").toString +: currentPath).mkString(java.io.File.pathSeparator)
    )
  }

  /** JupyterLab options making it assume it's reached at the passed address, typically via a
    * reverse proxy handling TLS: URLs are displayed with that address, its origin is accepted for
    * CORS / websocket connections, non-local `Host` headers are accepted, and the `X-Forwarded-*`
    * headers set by the proxy are trusted. If the address has a path, it becomes the base URL of the
    * server, and `/` redirects to it (see [[writeRootRedirectExtension]]).
    */
  private def baseAddressOptions(baseAddress: String): Seq[String] = {
    val uri = new java.net.URI(baseAddress)
    if (uri.getScheme == null || uri.getHost == null)
      sys.error(s"Invalid base address '$baseAddress', expected something like https://host:port")
    val origin = {
      val port = if (uri.getPort == -1) "" else s":${uri.getPort}"
      s"${uri.getScheme}://${uri.getHost}$port"
    }
    val baseUrlOpt = baseAddressPath(baseAddress).toSeq.flatMap { path =>
      Seq(
        s"--ServerApp.base_url=$path/",
        s"--ServerApp.jpserver_extensions=$rootRedirectExtension=True"
      )
    }
    Seq(
      s"--ServerApp.custom_display_url=$baseAddress",
      s"--ServerApp.allow_origin=$origin",
      "--ServerApp.allow_remote_access=True",
      "--ServerApp.trust_xheaders=True"
    ) ++ baseUrlOpt
  }

  /** The path of the passed base address, without trailing `/`, if it's not empty */
  private def baseAddressPath(baseAddress: String): Option[String] =
    Option(new java.net.URI(baseAddress).getPath).map(_.stripSuffix("/")).filter(_.nonEmpty)

  /** Name of the Jupyter server extension redirecting `/` to the base URL of the server, see
    * [[writeRootRedirectExtension]]
    */
  private def rootRedirectExtension = "plotly_scala_dev_root_redirect"

  /** Writes, under `dir`, the Python module of the Jupyter server extension redirecting `/` to the
    * base URL of the server, and returns `dir`, to put in `PYTHONPATH`
    *
    * When it has a base URL, Jupyter only serves things under it, and answers `/` with a 404:
    * whatever checks if the server is up by requesting `/` (like the service runners starting the
    * server behind a reverse proxy) would think it isn't.
    */
  private def writeRootRedirectExtension(dir: os.Path): os.Path = {
    val content =
      """from tornado import web
        |
        |
        |def _jupyter_server_extension_points():
        |    return [{"module": __name__}]
        |
        |
        |def _load_jupyter_server_extension(serverapp):
        |    if serverapp.base_url != "/":
        |        options = {"url": serverapp.base_url, "permanent": False}
        |        serverapp.web_app.add_handlers(".*$", [(r"/", web.RedirectHandler, options)])
        |""".stripMargin
    os.write.over(dir / s"$rootRedirectExtension.py", content, createFolders = true)
    dir
  }

  /** Links the notebooks of `demo/notebooks` from `notebooks`, the root directory of JupyterLab, so
    * that they're shown at the root of its file tree (`notebooks` itself is ignored by git, it holds
    * the notebooks users create). Saving them from JupyterLab writes to the files under
    * `demo/notebooks`. Files already in `notebooks` are left alone.
    */
  private def linkDemoNotebooks(workspace: os.Path): Unit = {
    val demoDir = workspace / "demo" / "notebooks"
    if (os.isDir(demoDir))
      for (nb <- os.list(demoDir) if nb.ext == "ipynb") {
        val link = workspace / "notebooks" / nb.last
        if (!os.exists(link, followLinks = false))
          try os.symlink(link, nb.relativeTo(link / os.up))
          catch {
            // symlinks may need specific permissions on Windows
            case _: java.io.IOException => os.copy(nb, link)
          }
      }
  }

  /** Installs almond kernels under `jupyterDir`, one per Scala version of [[scalaVersions]], and
    * returns the command running JupyterLab with them, from the uv-managed environment of
    * `jupyter/pyproject.toml`.
    *
    * JupyterLab and the kernels get `COURSIER_REPOSITORIES` pointing at `localRepo` first, so that
    * the dependencies users add get our modules from there. `args` may contain `--base-address=…`,
    * handled here, the rest is passed to JupyterLab.
    */
  def jupyterLabCommand(
      workspace: os.Path,
      localRepo: os.Path,
      jupyterDir: os.Path,
      args: Seq[String]
  ): Command = {
    val javaEnv = javaEnvironment(javaHome(Versions.devJvm))

    val kernelsDir = jupyterDir / "kernels"
    os.remove.all(kernelsDir)
    os.makeDir.all(kernelsDir)
    for (sv <- scalaVersions) {
      val binarySv = sv.split('.').take(2).mkString(".")
      val id       = "scala" + binarySv.filter(_ != '.')
      System.err.println(s"Installing almond kernel $id")
      os.proc(
        cs,
        "launch",
        "--use-bootstrap",
        s"almond:${Versions.almond}",
        "-r",
        mavenSnapshots,
        "--scala",
        sv,
        "--",
        "--install",
        // shows dependency downloads and their progress in the notebooks, rather than as
        // "Downloading ..." / "Downloaded ..." / "Failed to download ..." lines on stderr
        "--use-notebook-coursier-logger",
        "--jupyter-path",
        kernelsDir,
        "--id",
        id,
        "--display-name",
        s"Scala $binarySv (plotly-scala sources)"
      ).call(
        cwd = jupyterDir,
        env = javaEnv,
        stdin = "",
        // kept off our stdout, that `show dev.jupyterCmd` prints the command to
        stdout = os.ProcessOutput.Readlines(System.err.println),
        stderr = os.Inherit
      )
    }

    val repositories =
      Seq(localRepo.toNIO.toUri.toASCIIString.stripSuffix("/"), "ivy2Local", "central")
    val (baseAddressOpt, args0) = extractOption(args, "--base-address")
    os.makeDir.all(workspace / "notebooks")
    linkDemoNotebooks(workspace)
    val rootRedirectEnv = baseAddressOpt.flatMap(baseAddressPath).map { _ =>
      val dir = writeRootRedirectExtension(jupyterDir / "python")
      "PYTHONPATH" -> (dir.toString +: sys.env.get("PYTHONPATH").toSeq)
        .mkString(java.io.File.pathSeparator)
    }
    Command(
      workspace,
      javaEnv ++ Map(
        "JUPYTER_PATH"          -> jupyterDir.toString,
        "COURSIER_REPOSITORIES" -> repositories.mkString("|")
      ) ++ rootRedirectEnv,
      Seq(
        uv.toString,
        "run",
        "--project",
        (workspace / "jupyter").toString,
        "--frozen",
        "jupyter",
        "lab",
        "--notebook-dir",
        "notebooks"
      ) ++
        baseAddressOpt.toSeq.flatMap(baseAddressOptions) ++
        args0
    )
  }
}
